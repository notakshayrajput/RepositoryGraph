{
  "name": "git-graph-svg",
  "description": "Lightweight SVG-based Git commit graph renderer for React with automatic branch layout.",
  "private": false,
  "version": "2.0.5",
  "main": "dist/git-graph-svg.umd.js",
  "module": "dist/git-graph-svg.es.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "author": {
    "name": "Akshay Rajput",
    "url": "https://github.com/notakshayrajput"
  },
  "bugs": {
    "url": "https://github.com/notakshayrajput/RepositoryGraph/issues"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/git-graph-svg.es.js",
      "require": "./dist/git-graph-svg.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/notakshayrajput/RepositoryGraph.git"
  },
  "homepage": "https://github.com/notakshayrajput/RepositoryGraph",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/delaunator": "^5.0.3",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "delaunator": "^5.0.1"
  },
  "keywords": [
    "git",
    "git graph",
    "git visualization",
    "react git graph",
    "commit graph",
    "git branch graph",
    "git history visualization",
